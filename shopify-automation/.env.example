# --- Shopify (créer une app personnalisée dans Shopify Admin > Paramètres > Apps et canaux de vente > Développer des apps) ---
# Scopes API minimum requis : read_products, write_products, read_inventory, write_inventory,
# read_orders, write_orders, read_fulfillments, write_fulfillments
SHOPIFY_STORE_DOMAIN=votre-boutique.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10
# Secret de l'app, utilisé pour vérifier la signature HMAC des webhooks Shopify (obligatoire, ne jamais désactiver)
SHOPIFY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- CJ Dropshipping (créer un compte sur cjdropshipping.com puis générer une clé API dans
# My CJ > Authorization > Stores > API) ---
CJ_EMAIL=vous@example.com
CJ_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Règles de prix ---
# Multiplicateur appliqué au coût fournisseur (2.8 = +180%)
MARKUP_MULTIPLIER=2.8
# Marge minimale en EUR sous laquelle un produit est mis en brouillon plutôt que publié
MIN_MARGIN_EUR=8
# Devise d'affichage de la boutique
SHOP_CURRENCY=EUR

# --- Secret partagé pour les appels internes/cron déclenchés manuellement (facultatif) ---
INTERNAL_TRIGGER_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Requis UNIQUEMENT pour lancer le script local d'import produit (npm run import:product) ---
# afin qu'il écrive dans le même magasin Netlify Blobs que les fonctions déployées.
# Netlify Dashboard > Site settings > General > Site details (Site ID) et User settings > Applications > New access token
NETLIFY_SITE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NETLIFY_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
