# Copier ce fichier en `.env.local` (développement) — ne jamais committer de vraies valeurs.

# PostgreSQL. Le rôle utilisé NE DOIT PAS être superutilisateur ni avoir BYPASSRLS
# (sinon l'isolation par organisation au niveau base ne s'applique pas).
DATABASE_URL=postgres://mizania:mizania@localhost:5432/mizania

# URL publique de l'application (liens dans les emails de réinitialisation).
APP_URL=http://localhost:3000

# Assistant IA (optionnel). Laisser vide = assistant affiché comme « non configuré ».
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=
